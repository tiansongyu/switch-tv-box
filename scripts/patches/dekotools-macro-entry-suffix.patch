 	fprintf(f, "#else\n");
 	fprintf(f, "static const uint32_t %s_SetupCmds[] = {\n", name);
 	fprintf(f, "#endif\n");
-	fprintf(f, "\t0x%08X,\n", // MmeInstructionRamPointer+MmeInstructionRamLoad
