      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      }
    },
    {
      "label": "switch-tv-box: Rebuild + Upload",
      "dependsOrder": "sequence",
      "dependsOn": [
        "switch-tv-box: Clean",
        "switch-tv-box: Compile",
        "switch-tv-box: Upload"
      ],
      "problemMatcher": []
    },
    {
      "label": "switch-tv-box: Full Trace + Upload + Logs",
      "dependsOrder": "sequence",
      "dependsOn": [
        "switch-tv-box: Clean",
        "switch-tv-box: Compile Full Trace",
        "switch-tv-box: Upload + Logs"
      ],
      "problemMatcher": []
    }
  ]
