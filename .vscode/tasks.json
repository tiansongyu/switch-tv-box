{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "TV Box: Build and package (Docker)",
      "type": "shell",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/build-local.sh",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "TV Box: Tests (Docker)",
      "type": "shell",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/build-local.sh",
        "test"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "TV Box: Preview home UI",
      "type": "shell",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/preview_home.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "switch-tv-box: Clean",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/dev.sh",
        "clean"
      ],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/scripts/dev.ps1",
          "clean"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      }
    },
    {
      "label": "switch-tv-box: Compile",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/dev.sh",
        "build"
      ],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/scripts/dev.ps1",
          "build"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      }
    },
    {
      "label": "switch-tv-box: Compile Full Trace",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/dev.sh",
        "trace"
      ],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/scripts/dev.ps1",
          "trace"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      }
    },
    {
      "label": "switch-tv-box: Upload",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/dev.sh",
        "upload"
      ],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
